rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Root shops metadata
    match /shops/{shopId} {
      allow read: if true;
      allow write: if isAuthenticated();

      // Nested users subcollection
      match /users/{userId} {
        allow read, write: if true;
      }

      // Brands subcollection
      match /brands/{brandId} {
        allow read: if true;
        allow create: if request.resource.data.shopId == shopId
          && request.resource.data.createdBy.userId != null
          && request.resource.data.createdAt != null;
        allow update: if request.resource.data.shopId == shopId;
        allow delete: if true;
      }

      // Suppliers subcollection
      match /suppliers/{supplierId} {
        allow read: if true;
        allow create: if request.resource.data.shopId == shopId
          && request.resource.data.createdBy.userId != null
          && request.resource.data.createdAt != null;
        allow update: if request.resource.data.shopId == shopId;
        allow delete: if true;
      }

      // Categories subcollection (Level 1)
      match /categories/{categoryId} {
        allow read: if true;
        allow create: if request.resource.data.shopId == shopId
          && request.resource.data.createdBy.userId != null
          && request.resource.data.createdAt != null;
        allow update: if request.resource.data.shopId == shopId;
        allow delete: if true;
      }

      // Subcategories subcollection (Level 2)
      match /subcategories/{subcategoryId} {
        allow read: if true;
        allow create: if request.resource.data.shopId == shopId
          && request.resource.data.categoryId != null
          && request.resource.data.createdBy.userId != null
          && request.resource.data.createdAt != null;
        allow update: if request.resource.data.shopId == shopId;
        allow delete: if true;
      }

      // Products subcollection (Level 3)
      match /products/{productId} {
        allow read: if true;
        allow create: if request.resource.data.shopId == shopId
          && request.resource.data.subcategoryId != null
          && request.resource.data.createdBy.userId != null
          && request.resource.data.createdAt != null;
        allow update: if request.resource.data.shopId == shopId;
        allow delete: if true;
      }

      // Product Images metadata
      match /product_images/{imageId} {
        allow read: if true;
        allow create, update: if request.resource.data.shopId == shopId;
        allow delete: if true;
      }

      // Barcode print traceability logs
      match /barcode_logs/{logId} {
        allow read: if true;
        allow create: if request.resource.data.shopId == shopId
          && request.resource.data.printedBy.userId != null
          && request.resource.data.createdAt != null;
        allow update, delete: if false; // Immutable audit trail
      }

      // Stock transactions immutable audit trail
      match /stock_transactions/{txId} {
        allow read: if true;
        allow create: if request.resource.data.shopId == shopId
          && request.resource.data.performedBy.userId != null
          && request.resource.data.createdAt != null;
        allow update, delete: if false; // Immutable audit trail
      }

      // Sales subcollection (Mirror)
      match /sales/{saleId} {
        allow read: if true;
        allow create: if request.resource.data.shopId == shopId
          && request.resource.data.saleId != null
          && request.resource.data.items != null;
        allow update: if request.resource.data.shopId == shopId;
        allow delete: if false; // Original invoice records are never deleted
      }

      // Customers subcollection (Multi-tenant scoped)
      match /customers/{customerId} {
        allow read: if true;
        allow create: if request.resource.data.shopId == shopId
          && request.resource.data.name != null
          && request.resource.data.phone != null;
        allow update: if request.resource.data.shopId == shopId
          || resource.data.shopId == shopId;
        allow delete: if false; // Soft-delete via isActive flag only

        // Loyalty transaction log (append-only audit trail per customer)
        match /loyalty_transactions/{txId} {
          allow read: if true;
          allow create: if request.resource.data.shopId == shopId
            && request.resource.data.customerId == customerId;
          allow update, delete: if false; // Immutable loyalty ledger
        }
      }

      // Expenditures subcollection (Multi-tenant scoped)
      match /expenses/{expenseId} {
        allow read: if true;
        allow create: if request.resource.data.shopId == shopId
          && request.resource.data.amount != null
          && request.resource.data.date != null;
        allow update: if request.resource.data.shopId == shopId;
        allow delete: if resource.data.status != "posted"; // Posted expenses are never hard-deleted
      }

      // Expense Categories subcollection
      match /expense_categories/{categoryId} {
        allow read: if true;
        allow create, update: if request.resource.data.shopId == shopId;
        allow delete: if true;
      }

      // Recurring Expenses subcollection
      match /recurring_expenses/{scheduleId} {
        allow read: if true;
        allow create, update: if request.resource.data.shopId == shopId;
        allow delete: if true;
      }

      // Journal Entries subcollection (Double-entry accounting ledger)
      match /journal_entries/{jeId} {
        allow read: if true;
        allow create: if request.resource.data.shopId == shopId
          && request.resource.data.isBalanced == true;
        allow update, delete: if false; // Immutable general ledger audit trail
      }

      // Repair Management collection (Multi-tenant isolated)
      match /repairs/{repairId} {
        allow read: if true;
        allow create: if request.resource.data.shopId == shopId
          && request.resource.data.ticketNumber != null;
        allow update: if request.resource.data.shopId == shopId;
        allow delete: if false; // Repair audit history is permanent

        // Diagnostics subcollection
        match /diagnostics/{diagId} {
          allow read: if true;
          allow create, update: if request.resource.data.shopId == shopId;
          allow delete: if false;
        }

        // Estimates subcollection (Versioned quotes)
        match /estimates/{estimateId} {
          allow read: if true;
          allow create, update: if request.resource.data.shopId == shopId;
          allow delete: if false;
        }

        // Tasks / Work logs subcollection
        match /tasks/{taskId} {
          allow read: if true;
          allow create, update: if request.resource.data.shopId == shopId;
          allow delete: if true;
        }

        // Parts Usage subcollection
        match /parts_usage/{partUsageId} {
          allow read: if true;
          allow create, update: if request.resource.data.shopId == shopId;
          allow delete: if false;
        }

        // Payments subcollection (Deposits, Balances, Refunds)
        match /payments/{paymentId} {
          allow read: if true;
          allow create: if request.resource.data.shopId == shopId
            && request.resource.data.amount != null;
          allow update: if request.resource.data.shopId == shopId;
          allow delete: if false; // Financial records are immutable
        }

        // Status Transition History (Immutable audit trail)
        match /status_history/{historyId} {
          allow read: if true;
          allow create: if request.resource.data.shopId == shopId;
          allow update, delete: if false; // Permanent audit log
        }

        // Quality Control checklist
        match /qc_checks/{qcId} {
          allow read: if true;
          allow create, update: if request.resource.data.shopId == shopId;
          allow delete: if false;
        }

        // Warranties and claims
        match /warranties/{warrantyId} {
          allow read: if true;
          allow create, update: if request.resource.data.shopId == shopId;
          allow delete: if false;
        }
      }
    }

    // Root Users collection (Multi-tenant staff & RBAC directory)
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.resource.data.shopId != null;
      allow delete: if true;
    }

    // Root Sales collection (Multi-tenant isolated by shopId)
    match /sales/{saleId} {
      allow read: if true;
      allow create: if request.resource.data.shopId != null
        && request.resource.data.saleId != null
        && request.resource.data.items != null;
      allow update: if request.resource.data.shopId == resource.data.shopId;
      allow delete: if true;
    }

    // Root Repairs collection mirror
    match /repairs/{repairId} {
      allow read: if true;
      allow create, update: if request.resource.data.shopId != null;
      allow delete: if false;
    }

    // Root Customers collection fallback (Multi-tenant isolated by shopId)
    match /customers/{customerId} {
      allow read: if true;
      allow create, update: if request.resource.data.shopId != null
        && request.resource.data.name != null
        && request.resource.data.phone != null;
      allow delete: if false;
    }

    // Root Expenses collection fallback (Multi-tenant isolated by shopId)
    match /expenses/{expenseId} {
      allow read: if true;
      allow create, update: if request.resource.data.shopId != null;
      allow delete: if resource.data.status != "posted";
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
